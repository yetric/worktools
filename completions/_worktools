#compdef worktools dev pod svc db dots agentsetup

_worktools_dev_actions() {
  local -a actions directory_args
  [[ -n "$worktools_directory" ]] && directory_args=(--directory "$worktools_directory")
  actions=(${(f)"$(command worktools complete dev "${directory_args[@]}" 2>/dev/null)"})
  [[ "$worktools_dev_inspect" != yes ]] && actions+=(${(f)"$(command worktools complete dev --kind commands 2>/dev/null)"})
  _describe 'project action' actions
}

_worktools_units() {
  local -a units
  local -a scope_args
  [[ "$worktools_scope" == --system ]] && scope_args=(--system)
  units=(${(f)"$(command worktools complete svc "${scope_args[@]}" 2>/dev/null)"})
  _describe 'service or timer' units
}

_worktools_connections() {
  local -a connections
  local -a directory_args
  [[ -n "$worktools_directory" ]] && directory_args=(--directory "$worktools_directory")
  connections=(${(f)"$(command worktools complete db "${directory_args[@]}" 2>/dev/null)"})
  _describe 'database connection' connections
}

_worktools_pod_values() {
  local -a entries arguments
  local word next
  local -i index
  # _arguments shifts words for subcommands. Keep global options on either side
  # of the operation when completing service names, stopping at native arguments.
  for (( index = 2; index <= ${#worktools_original_words}; index++ )); do
    word="${(Q)worktools_original_words[index]}"
    [[ "$word" == -- ]] && break
    case "$word" in
      --directory|--provider|--file)
        (( index++ ))
        next="${(Q)worktools_original_words[index]}"
        [[ -n "$next" ]] && arguments+=("$word" "$next")
        ;;
      --directory=*|--provider=*|--file=*) arguments+=("$word") ;;
    esac
  done
  entries=(${(f)"$(command worktools complete pod --kind "$1" "${arguments[@]}" 2>/dev/null)"})
  if [[ "$1" == actions ]]; then
    entries+=(${(f)"$(command worktools complete pod --kind inspection 2>/dev/null)"})
  fi
  _describe "$1" entries
}

_worktools_commands() {
  local -a entries
  entries=(${(f)"$(command worktools complete "$service" --kind commands 2>/dev/null)"})
  _describe 'action' entries
}

_worktools_agent_tools() {
  local -a entries
  entries=(${(f)"$(command worktools complete agent --kind tools 2>/dev/null)"})
  _describe 'tool' entries
}

_worktools_agent_files() {
  local -a entries
  entries=(${(f)"$(command worktools complete agent --kind files 2>/dev/null)"})
  _describe 'instruction file' entries
}

_worktools() {
  local context state line curcontext="$curcontext"
  local service="${service:-${words[1]}}"
  if [[ "$service" == agentsetup ]]; then
    service=worktools
    words=(worktools agent init "${words[@]:1}")
    (( CURRENT += 2 ))
  fi
  local -A opt_args
  local -a commands names pod_options worktools_original_words=("${words[@]}")
  local -i worktools_original_current=$CURRENT
  local worktools_scope=--user worktools_directory='' worktools_dev_inspect=no
  if [[ "$service" == worktools ]]; then
    if (( CURRENT == 2 )); then
      commands=(${(f)"$(command worktools complete tools 2>/dev/null)"})
      _describe 'tool' commands
      return
    fi
    service="${words[2]}"
    words=("${words[@]:1}")
    (( CURRENT-- ))
  fi
  names=(shell git profile ghostty alacritty zed starship fonts mise)
  case "$service" in
    agent)
      _arguments -C '--help[Show help]' '--directory=[Project directory]:directory:_directories' '--tools=[Comma-separated tools]:tools:{_sequence -s , _worktools_agent_tools}' '--files=[Comma-separated targets]:files:{_sequence -s , _worktools_agent_files}' '--json[Structured plan or result (preview/sync)]' '--check[Exit 1 if preview finds changes]' '1:action:_worktools_commands' '2:project directory:_directories'
      ;;
    pod)
      local pod_action_hint='' pod_word
      local -i pod_index
      for (( pod_index = 2; pod_index < CURRENT; pod_index++ )); do
        pod_word="${(Q)words[pod_index]}"
        case "$pod_word" in
          --) break ;;
          --directory|--provider|--file) (( pod_index++ )) ;;
          -*) ;;
          *) pod_action_hint="$pod_word"; break ;;
        esac
      done
      pod_options=('--help[Show help]' '--directory=[Working directory]:directory:_directories' '--provider=[Select backend]:provider:{_worktools_pod_values providers}' '--json[Structured inspection]')
      case "$pod_action_hint" in
        providers|actions) ;;
        containers) pod_options+=('--dry-run[Explain without execution]' '--pick[Choose interactively]' '(-a --all)'{-a,--all}'[Include stopped containers]') ;;
        *)
          pod_options+=('--file=[Compose file]:file:_files' '--dry-run[Explain without execution]' '--pick[Choose interactively]')
          case "$pod_action_hint" in
            up) pod_options+=('(-d --detach)'{-d,--detach}'[Start in the background]') ;;
            logs) pod_options+=('(-f --follow)'{-f,--follow}'[Follow log output]') ;;
            explain|'') pod_options+=('(-a --all)'{-a,--all}'[Include stopped containers (containers)]' '(-d --detach)'{-d,--detach}'[Start in the background (up)]' '(-f --follow)'{-f,--follow}'[Follow log output (logs)]') ;;
          esac
          ;;
      esac
      _arguments -C "${pod_options[@]}" '1:operation:->pod-actions' '*::argument:->pod-args'
      worktools_directory="${(Q)opt_args[--directory]}"
      ;;
    dev)
      _arguments -C '--help[Show help]' '--directory=[Project directory]:directory:_directories' '--json[Structured inspection output]' '--dry-run[Explain without executing]' '--pick[Choose an action; uses fzf if available]' '1:action:->dev-actions' '*::argument:->dev-args'
      worktools_directory="${(Q)opt_args[--directory]}"
      ;;
    svc)
      _arguments -C '--help[Show help]' '--system[Use system units]' '1:action:->commands' '*::argument:->args'
      [[ -n "${opt_args[--system]}" ]] && worktools_scope=--system
      ;;
    db)
      _arguments -C '--help[Show help]' '--directory=[Project directory]:directory:_directories' '1:action:->commands' '*::argument:->args'
      worktools_directory="${(Q)opt_args[--directory]}"
      ;;
    dots)
      _arguments -C '--help[Show help]' '1:action:->commands' '*::argument:->args'
      ;;
  esac
  local worktools_action="$line[1]"
  case "$state" in
    pod-args|dev-args|args)
      words=("${worktools_original_words[@]}")
      CURRENT=$worktools_original_current
      if [[ "$words[1]" == worktools ]]; then
        words=("${words[@]:1}")
        (( CURRENT-- ))
      fi
      ;;
  esac
  case "$state" in
    pod-actions) _worktools_pod_values actions ;;
    pod-args)
      case "$worktools_action" in
        explain) _arguments "${pod_options[@]}" '1:operation:' '2:operation:{_worktools_pod_values operations}' ;;
        providers|actions|services) _arguments "${pod_options[@]}" '1:operation:' ;;
        containers) _arguments "${pod_options[@]}" '1:operation:' ;;
        exec) _arguments "${pod_options[@]}" '1:operation:' '2:service:{_worktools_pod_values services}' '*:container command argument:' ;;
        *) _arguments "${pod_options[@]}" '1:operation:' '*:service:{_worktools_pod_values services}' ;;
      esac
      ;;
    dev-actions) _worktools_dev_actions ;;
    dev-args)
      if [[ "$worktools_action" == explain ]]; then
        worktools_dev_inspect=yes
        _arguments '--help[Show help]' '--directory=[Project directory]:directory:_directories' '--json[Structured output]' '1:command:' '2:action:_worktools_dev_actions'
      elif [[ "$worktools_action" == list ]]; then
        _arguments '--help[Show help]' '--directory=[Project directory]:directory:_directories' '--json[Structured output]' '1:command:'
      else
        _arguments '--help[Show help]' '--dry-run[Explain without executing]' '--json[Structured dry-run output]' '--pick[Choose an action; uses fzf if available]' '--directory=[Project directory]:directory:_directories' '1:action:' '*:runner argument:_files'
      fi
      ;;
    commands) _worktools_commands ;;
    args)
      case "$service:$worktools_action" in
        svc:logs) _arguments '1:action:' '--help[Show help]' '--system[Use system units]' '--json[JSON lines]' '(-f --follow)'{-f,--follow}'[Follow new entries]' '(-n --lines)'{-n,--lines}'[Number of entries]:lines:' '--since=[Show entries since]:time:' '2:unit:_worktools_units' ;;
        svc:status) _arguments '1:action:' '--help[Show help]' '--system[Use system units]' '--json[Structured output]' '2:unit:_worktools_units' ;;
        svc:start|svc:stop|svc:restart) _arguments '1:action:' '--help[Show help]' '--system[Use system units]' '2:unit:_worktools_units' ;;
        svc:list) _arguments '1:action:' '--help[Show help]' '--system[Use system units]' '--json[Structured output]' '--aliases[List configured aliases without contacting systemd]' ;;
        svc:*) _arguments '1:action:' '--help[Show help]' '--system[Use system units]' '--json[Structured output]' ;;
        db:info) _arguments '1:action:' '--help[Show help]' '--directory=[Project directory]:directory:_directories' '--json[Structured output]' '2:connection:_worktools_connections' ;;
        db:connect) _arguments '1:action:' '--help[Show help]' '--directory=[Project directory]:directory:_directories' '--pick[Choose interactively; uses fzf if available]' '2:connection:_worktools_connections' ;;
        db:query) _arguments '1:action:' '--help[Show help]' '--directory=[Project directory]:directory:_directories' '--file=[SQL file]:file:_files' '2:connection:_worktools_connections' ;;
        db:list) _arguments '1:action:' '--help[Show help]' '--directory=[Project directory]:directory:_directories' '--json[Structured output]' ;;
        dots:show|dots:check) _arguments '1:action:' '--help[Show help]' '--json[Structured output]' "2:configuration:($names)" ;;
        dots:edit) _arguments '1:action:' '--help[Show help]' '--pick[Choose interactively; uses fzf if available]' "2:configuration:($names)" ;;
        dots:diff) _arguments '1:action:' '--help[Show help]' "2:configuration:($names)" ;;
        dots:list) _arguments '1:action:' '--help[Show help]' '--json[Structured output]' ;;
      esac
      ;;
  esac
}

_worktools "$@"
