#compdef worktools dev pod svc db dots

_worktools_dev_actions() {
  local -a actions directory_args
  [[ -n "$worktools_directory" ]] && directory_args=(--directory "$worktools_directory")
  actions=(${(f)"$(command worktools complete dev "${directory_args[@]}" 2>/dev/null)"})
  [[ "$worktools_dev_inspect" != yes ]] && actions+=('list:List available project actions' 'explain:Explain how an action is resolved')
  _describe 'project action' actions
}

_worktools_units() {
  local -a units
  local -a scope_args
  [[ "$worktools_scope" == --system ]] && scope_args=(--system)
  units=(${(f)"$(command worktools complete svc "${scope_args[@]}" 2>/dev/null)"})
  _describe 'service or timer' units
}

_worktools_connections() {
  local -a connections
  local -a directory_args
  [[ -n "$worktools_directory" ]] && directory_args=(--directory "$worktools_directory")
  connections=(${(f)"$(command worktools complete db "${directory_args[@]}" 2>/dev/null)"})
  _describe 'database connection' connections
}

_worktools_pod_values() {
  local -a entries arguments
  local word next
  local -i index
  # _arguments shifts words for subcommands. Keep global options on either side
  # of the operation when completing service names, stopping at native arguments.
  for (( index = 2; index <= ${#worktools_original_words}; index++ )); do
    word="$worktools_original_words[index]"
    [[ "$word" == -- ]] && break
    case "$word" in
      --directory|--provider|--file)
        (( index++ ))
        next="$worktools_original_words[index]"
        [[ -n "$next" ]] && arguments+=("$word" "$next")
        ;;
      --directory=*|--provider=*|--file=*) arguments+=("$word") ;;
    esac
  done
  entries=(${(f)"$(command worktools complete pod --kind "$1" "${arguments[@]}" 2>/dev/null)"})
  if [[ "$1" == actions ]]; then
    entries+=('providers:Inspect available container providers' 'explain:Explain backend and planned command' 'actions:List selected provider operations')
  fi
  _describe "$1" entries
}

_worktools() {
  local context state line curcontext="$curcontext"
  local service="${service:-${words[1]}}"
  local -A opt_args
  local -a commands names pod_options worktools_original_words=("${words[@]}")
  local -i worktools_original_current=$CURRENT
  local worktools_scope=--user worktools_directory='' worktools_dev_inspect=no
  if [[ "$service" == worktools ]]; then
    if (( CURRENT == 2 )); then
      commands=('pod:Project container operations' 'dev:Project development actions' 'svc:Services and timers' 'db:Project database connections' 'dots:Dotfiles inspection and editing')
      _describe 'tool' commands
      return
    fi
    service="${words[2]}"
    words=("${words[@]:1}")
    (( CURRENT-- ))
  fi
  names=(shell git profile ghostty alacritty zed starship fonts mise)
  case "$service" in
    pod)
      pod_options=('--help[Show help]' '--directory[Working directory]:directory:_directories' '--provider[Select backend]:provider:{_worktools_pod_values providers}' '--file[Compose file]:file:_files' '--json[Structured inspection]' '--dry-run[Explain without execution]' '--pick[Choose interactively]')
      _arguments -C "${pod_options[@]}" '1:operation:->pod-actions' '*::argument:->pod-args'
      worktools_directory="${opt_args[--directory]}"
      ;;
    dev)
      _arguments -C '--help[Show help]' '--directory[Project directory]:directory:_directories' '--json[Structured inspection output]' '--dry-run[Explain without executing]' '--pick[Choose an action; uses fzf if available]' '1:action:->dev-actions' '*::argument:->dev-args'
      worktools_directory="${opt_args[--directory]}"
      ;;
    svc)
      commands=('list:List services' 'status:Inspect a unit' 'start:Start a unit' 'stop:Stop a unit' 'restart:Restart a unit' 'logs:Read unit logs' 'timers:List timers' 'failed:List failed units')
      _arguments -C '--help[Show help]' '--system[Use system units]' '1:action:->commands' '*::argument:->args'
      [[ -n "${opt_args[--system]}" ]] && worktools_scope=--system
      ;;
    db)
      commands=('list:List configured connections' 'info:Inspect a connection' 'connect:Open the native client' 'query:Execute a SQL file')
      _arguments -C '--help[Show help]' '--directory[Project directory]:directory:_directories' '1:action:->commands' '*::argument:->args'
      worktools_directory="${opt_args[--directory]}"
      ;;
    dots)
      commands=('list:List configuration paths' 'show:Inspect a configuration' 'edit:Edit the actual source' 'check:Check links and supported syntax' 'diff:Show Git changes')
      _arguments -C '--help[Show help]' '1:action:->commands' '*::argument:->args'
      ;;
  esac
  case "$state" in
    pod-actions) _worktools_pod_values actions ;;
    pod-args)
      local pod_action="$line[1]"
      words=("${worktools_original_words[@]}")
      CURRENT=$worktools_original_current
      if [[ "$words[1]" == worktools ]]; then
        words=("${words[@]:1}")
        (( CURRENT-- ))
      fi
      case "$pod_action" in
        explain) _arguments "${pod_options[@]}" '1:operation:' '2:operation:{_worktools_pod_values actions}' ;;
        providers|actions|services) _arguments "${pod_options[@]}" '1:operation:' ;;
        *) _arguments "${pod_options[@]}" '1:operation:' '(-d --detach)'{-d,--detach}'[Start detached (up)]' '(-f --follow)'{-f,--follow}'[Follow output (logs)]' '*:service:{_worktools_pod_values services}' ;;
      esac
      ;;
    dev-actions) _worktools_dev_actions ;;
    dev-args)
      if [[ "$words[1]" == explain ]]; then
        worktools_dev_inspect=yes
        _arguments '--help[Show help]' '--json[Structured output]' '1:action:_worktools_dev_actions'
      elif [[ "$words[1]" == list ]]; then
        _arguments '--help[Show help]' '--json[Structured output]'
      else
        _arguments '--help[Show help]' '--dry-run[Explain without executing]' '--json[Structured dry-run output]' '--pick[Choose an action; uses fzf if available]' '*:runner argument:_files'
      fi
      ;;
    commands) _describe 'action' commands ;;
    args)
      case "$service:$words[1]" in
        svc:logs) _arguments '--help[Show help]' '--json[JSON lines]' '(-f --follow)'{-f,--follow}'[Follow new entries]' '(-n --lines)'{-n,--lines}'[Number of entries]:lines:' '--since[Show entries since]:time:' '1:unit:_worktools_units' ;;
        svc:status) _arguments '--help[Show help]' '--json[Structured output]' '1:unit:_worktools_units' ;;
        svc:start|svc:stop|svc:restart) _arguments '--help[Show help]' '1:unit:_worktools_units' ;;
        svc:list) _arguments '--help[Show help]' '--json[Structured output]' '--aliases[List configured aliases without contacting systemd]' ;;
        svc:*) _arguments '--help[Show help]' '--json[Structured output]' ;;
        db:info) _arguments '--help[Show help]' '--json[Structured output]' '1:connection:_worktools_connections' ;;
        db:connect) _arguments '--help[Show help]' '--pick[Choose interactively; uses fzf if available]' '1:connection:_worktools_connections' ;;
        db:query) _arguments '--help[Show help]' '--file[SQL file]:file:_files' '1:connection:_worktools_connections' ;;
        db:list) _arguments '--help[Show help]' '--json[Structured output]' ;;
        dots:show|dots:check) _arguments '--help[Show help]' '--json[Structured output]' "1:configuration:($names)" ;;
        dots:edit) _arguments '--help[Show help]' '--pick[Choose interactively; uses fzf if available]' "1:configuration:($names)" ;;
        dots:diff) _arguments '--help[Show help]' "1:configuration:($names)" ;;
        dots:list) _arguments '--help[Show help]' '--json[Structured output]' ;;
      esac
      ;;
  esac
}

_worktools "$@"
